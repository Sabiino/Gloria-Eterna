rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Temporary test-editor access. Replace with a custom admin claim before launch.
    function uniformEditor() { return signedIn() && request.auth.uid == 'wwv5MkWYCgTjYFKv1UkzX8C8yma2'; }
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarId', 'campName']);
      allow delete: if false;
    }
    match /users/{uid} { allow read: if owner(uid); allow create, update: if false; match /private/{docId} { allow read: if owner(uid); allow write: if false; } match /career/{docId} { allow read: if owner(uid); allow write: if false; } }
    match /camps/{campId} { allow read: if signedIn(); allow write: if false; }
    match /inventories/{uid} { allow read: if owner(uid); allow write: if false; }
    match /gameStates/{uid} { allow read: if owner(uid); allow write: if false; }
    match /usernames/{nickname} { allow read, write: if false; }
    match /worldSectors/{sectorId} { allow read: if signedIn(); allow write: if false; }
    match /uniforms/miguel/library/{imageId} {
      allow read: if signedIn();
      allow write: if uniformEditor();
    }
    match /uniforms/miguel/layers/{layerId} {
      allow read: if signedIn();
      allow write: if uniformEditor();
    }
    match /uniforms/miguel/categories/{categoryId} {
      allow read: if signedIn();
      allow write: if uniformEditor();
    }
  }
}
